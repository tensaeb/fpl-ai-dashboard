# ============================================================================
# FPL//AI  ·  example environment variables
#
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and never committed.
# ============================================================================

# ----------------------------------------------------------------------------
# SUPABASE / POSTGRES (required for persistence)
# ----------------------------------------------------------------------------
# Get your connection string from:
#   supabase.com → your project → top bar "Connect" → "App frameworks"
#   → Postgres → "Session pooler" URI
#
# Use the pooler URI (aws-0-*.pooler.supabase.com) — NOT the direct host.
# DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# ----------------------------------------------------------------------------
# Session (required — generate a random 32+ byte hex string)
# ----------------------------------------------------------------------------
SESSION_SECRET=

# ----------------------------------------------------------------------------
# AI — Gemini (free tier, recommended)
# ----------------------------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey (no credit card)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ----------------------------------------------------------------------------
# AI — Claude (alternative, paid)
# ----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ----------------------------------------------------------------------------
# Email via Resend (optional — magic-link sign-in + weekly digest emails)
# ----------------------------------------------------------------------------
# RESEND_API_KEY=
# RESEND_FROM=FPL//AI <briefs@yourdomain.com>

# ----------------------------------------------------------------------------
# Public origin (required in production, leave unset for local dev)
# ----------------------------------------------------------------------------
# PUBLIC_APP_URL=https://yourapp.vercel.app

# ----------------------------------------------------------------------------
# Cron authentication token (Vercel cron → /api/cron/run)
# ----------------------------------------------------------------------------
# CRON_SECRET=
